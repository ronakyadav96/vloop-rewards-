{
  "info": {"name": "VELoop Rewards API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Local API collection. Set baseUrl, email, displayName, and password in a Postman environment."},
  "variable": [
    {"key":"baseUrl","value":"http://localhost:5002/api"}, {"key":"email","value":"demo@example.com"}, {"key":"displayName","value":"Demo User"}, {"key":"password","value":"change-me-123"}, {"key":"token","value":""}, {"key":"idempotencyKey","value":"postman-day-1-{{$guid}}"}
  ],
  "item": [
    {"name":"Auth","item":[
      {"name":"Register","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"password\": \"{{password}}\"\n}"},"url":{"raw":"{{baseUrl}}/auth/register"}},"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().token);"]}}]},
      {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},"url":{"raw":"{{baseUrl}}/auth/login"}},"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"]}}]},
      {"name":"Current user","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/auth/me"}}},
      {"name":"Logout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/auth/logout"}}}
    ]},
    {"name":"Daily Streak","item":[
      {"name":"Status","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/daily-streak/status"}}},
      {"name":"Claim","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}"},"url":{"raw":"{{baseUrl}}/daily-streak/claim"}}},
      {"name":"History","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/daily-streak/history?limit=50"}}},
      {"name":"Streak config","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/streak/config"}}}
    ]}
  ]
}
