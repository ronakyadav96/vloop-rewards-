NODE_ENV=development
PORT=5002
# Daily Streak claims use MongoDB transactions; use a replica set or Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/veloop_rewards?replicaSet=rs0
JWT_SECRET=replace-with-a-long-development-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Seeding is opt-in. Existing documents are never overwritten by the seed script.
SEED_STREAK_REWARDS=false
# Keep false outside local development unless you have reviewed the data carefully.
ALLOW_PRODUCTION_SEED=false
